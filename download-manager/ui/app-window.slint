import { Button, ListView } from "std-widgets.slint";

// 列表里每一行。Rust 侧的 Vec<DownloadTask> 会被映射成这个结构。
export struct DownloadItem {
    name: string,
    progress: string,
    status: string,
    action: string,
    can-act: bool,
}

export component AppWindow inherits Window {
    title: "Download Manager";
    preferred-width: 640px;
    preferred-height: 600px;

    // Vec<DownloadTask> -> VecModel<DownloadItem> -> ModelRc -> 这个属性
    in property <[DownloadItem]> downloads;

    // 点某一行里的按钮；参数是该行下标，Rust 用它定位任务
    callback task-clicked(int);

    ListView {
        for item[index] in downloads: Rectangle {
            height: 64px;
            border-width: 1px;
            border-color: #c9c9c9;

            HorizontalLayout {
                // 关键：cross-axis-alignment 默认是 stretch —— 子项会被撑满行高，
                // 文字因此顶对齐。center 让每个子项按自身高度在行内垂直居中，
                // 文字和按钮一起居中，按钮也不用再靠 height: 80% 去压。
                cross-axis-alignment: center;

                padding: 10px;
                spacing: 8px;

                // 文件名：占满剩余宽度，超长省略。
                // overflow: elide 会把 Text 的 min-width 从"整段文字宽度"降到 0，
                // 因此文件名再长也只是自己变成省略号，不会把右边的进度/状态挤走。
                Text {
                    text: item.name;
                    font-size: 18px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // 进度：固定宽度。位置不受文件名影响，宽度也不随 0%→100% 的字宽变化。
                Text {
                    min-width: 80px;
                    max-width: 80px;
                    text: item.progress;
                    font-size: 26px;
                    font-weight: 700;
                }

                // 状态：同样固定宽度，避免 Downloading/Paused 字宽不同让按钮左右跳。
                Text {
                    min-width: 100px;
                    max-width: 100px;
                    text: item.status;
                    font-size: 14px;
                    color: #666666;
                }

                Button {
                    min-width: 86px;
                    max-width: 86px;
                    text: item.action;
                    visible: item.can-act;
                    clicked => {
                        task-clicked(index);
                    }
                }
            }
        }
    }
}
