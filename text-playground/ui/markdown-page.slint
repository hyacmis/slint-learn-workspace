import { Button, TextEdit } from "std-widgets.slint";
import { MarkdownActionResult, MarkdownOperation } from "operations.slint";

export component MarkdownPage inherits Rectangle {
    private property <string> markdown-text: "# Markdown 编辑器\n\n使用上方工具插入常见 Markdown 格式。";
    private property <string> message: "点击格式按钮，将模板添加到文档末尾";

    callback markdown-changed(string) -> string;
    callback operation-clicked(MarkdownOperation) -> MarkdownActionResult;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 12px;

        Text {
            text: "Markdown 编辑器";
            font-size: 26px;
            horizontal-alignment: center;
        }

        Text {
            text: "编辑 Markdown 源码，选择格式按钮将模板添加到文档末尾。";
            color: #666666;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "一级标题";
                clicked => { root.insert-template(MarkdownOperation.heading-one); }
            }
            Button {
                text: "二级标题";
                clicked => { root.insert-template(MarkdownOperation.heading-two); }
            }
            Button {
                text: "粗体";
                clicked => { root.insert-template(MarkdownOperation.bold); }
            }
            Button {
                text: "斜体";
                clicked => { root.insert-template(MarkdownOperation.italic); }
            }
            Button {
                text: "行内代码";
                clicked => { root.insert-template(MarkdownOperation.inline-code); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "链接";
                clicked => { root.insert-template(MarkdownOperation.link); }
            }
            Button {
                text: "无序列表";
                clicked => { root.insert-template(MarkdownOperation.unordered-list); }
            }
            Button {
                text: "有序列表";
                clicked => { root.insert-template(MarkdownOperation.ordered-list); }
            }
            Button {
                text: "引用";
                clicked => { root.insert-template(MarkdownOperation.quote); }
            }
            Button {
                text: "代码块";
                clicked => { root.insert-template(MarkdownOperation.code-block); }
            }
        }

        TextEdit {
            vertical-stretch: 1;
            placeholder-text: "在这里编写 Markdown...";
            text <=> markdown-text;
            edited(text) => { message = root.markdown-changed(text); }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: message;
                color: #555555;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "清空文档";
                clicked => {
                    markdown-text = "";
                    message = "Markdown 文档已清空";
                }
            }
        }
    }

    function insert-template(operation: MarkdownOperation) {
        let result = root.operation-clicked(operation);
        if markdown-text != "" && !markdown-text.ends-with("\n") {
            markdown-text += "\n";
        }
        markdown-text += result.template;
        message = result.message;
    }
}
